# Generated example .gitignore. Change as needed

# ---------- PlatformIO / firmware ----------
.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# Secrets (commit secrets.example.h instead)
firmware/include/secrets.h

# ---------- Server: Python ----------
__pycache__/
*.pyc
venv/
.venv/

# ---------- Server: Node ----------
node_modules/
dist/

# ---------- Environment / secrets ----------
.env
*.env.local

# ---------- OS / editor junk ----------
.DS_Store
Thumbs.db
*.swp
*.log