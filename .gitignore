# Generated example .gitignore. Change as needed

# ---------- PlatformIO / firmware ----------
.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
# The Qt app's debug configs have no machine-specific paths; share them
!qtApplication/.vscode/launch.json
**/.vscode/ipch

# Secrets (commit secrets.example.h instead)
firmware/include/secrets.h

# ---------- Qt / CMake ----------
# Build output (contains absolute paths in CMakeCache.txt, compile_commands.json, etc.)
build/
builds/
CMakeUserPresets.json
compile_commands.json
.cache/
# Generated by the Qt VS Code extension with an absolute buildDir
.qmlls.ini
# Qt Creator per-user settings
CMakeLists.txt.user*

# ---------- Per-user VS Code settings ----------
# Generated with absolute paths; shared settings live in the root and
# qtApplication .vscode/settings.json (which use ${workspaceFolder})
firmware/.vscode/settings.json

# ---------- Server: Python ----------
__pycache__/
*.pyc
venv/
.venv/

# ---------- Server: Node ----------
node_modules/
dist/

# ---------- Environment / secrets ----------
.env
*.env.local

# ---------- OS / editor junk ----------
.DS_Store
Thumbs.db
*.swp
*.log